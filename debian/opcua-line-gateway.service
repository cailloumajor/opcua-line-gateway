[Unit]
Description=OPC-UA gateway for production line
# The gateway connects to the PLCs and to ClickHouse as soon as it starts, and
# exits if the first draining task run fails, so wait for a usable network.
Wants=network-online.target
After=network-online.target
# Never give up restarting: this service is meant to run forever, and the PLCs
# or the database may stay unreachable for a long time.
StartLimitIntervalSec=0
# Do not start until the administrator has installed both files, examples of
# which are shipped in /usr/share/doc/opcua-line-gateway/examples.
ConditionPathExists=/etc/opcua-line-gateway/config.toml
ConditionPathExists=/etc/credstore/opcua-line-gateway.toml

[Service]
Type=exec
User=opcua-line-gateway
Group=opcua-line-gateway

# The configuration file path is the first positional argument.
ExecStart=/usr/bin/opcua-line-gateway /etc/opcua-line-gateway/config.toml

ExecReload=/usr/bin/kill -HUP $MAINPID

# Credentials are read by systemd as root from its credential store, only
# accessible by root, i.e. /etc/credstore/opcua-line-gateway.toml. They are
# exposed to the service in $CREDENTIALS_DIRECTORY, as credentials.toml.
LoadCredential=credentials.toml:opcua-line-gateway.toml
# /var/lib/opcua-line-gateway, holding the redb cache file and the OPC-UA PKI.
StateDirectory=opcua-line-gateway
StateDirectoryMode=0750
# Relative paths in the configuration file resolve against the state directory.
WorkingDirectory=%S/opcua-line-gateway
LogsDirectory=opcua-line-gateway

# Logs are emitted to daily rotated files in the logs directory by `tracing`.
Environment=RUST_LOG=info

# Termination signals trigger a graceful shutdown of the OPC-UA sessions and of
# the part sheets draining task.
KillSignal=SIGTERM
TimeoutStopSec=30s
Restart=always
RestartSec=5s

# Hardening
CapabilityBoundingSet=
NoNewPrivileges=yes
LockPersonality=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target

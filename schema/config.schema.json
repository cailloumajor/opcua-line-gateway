{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LineGatewayConfig",
  "description": "OPC-UA line gateway configuration.",
  "type": "object",
  "properties": {
    "application_uri": {
      "description": "Globally unique identifier for the application instance, as of OPC-UA.",
      "type": "string"
    },
    "machines": {
      "description": "Connected machines configuration, mapped by machine identifier.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/MachineConfig"
      }
    },
    "pki_dir": {
      "description": "Root directory of the OPC-UA PKI.",
      "type": "string"
    },
    "traceability": {
      "description": "Traceability configuration for all machines.",
      "$ref": "#/$defs/CommonTraceabilityConfig"
    }
  },
  "required": [
    "application_uri",
    "pki_dir",
    "traceability",
    "machines"
  ],
  "x-tombi-string-formats": [
    "uri"
  ],
  "$defs": {
    "CommonTraceabilityConfig": {
      "description": "Traceability configuration for all machines.",
      "type": "object",
      "properties": {
        "database": {
          "description": "ClickHouse database client configuration for archiving traceability data.",
          "$ref": "#/$defs/DatabaseClientConfig"
        },
        "redb_file": {
          "description": "Path to the redb file to use for traceability cache. It will be created\nif it does not exist.",
          "type": "string"
        }
      },
      "required": [
        "redb_file",
        "database"
      ]
    },
    "CreatePartIdConfig": {
      "description": "Configuration related to part ID creation for a machine.",
      "type": "object",
      "properties": {
        "line_id": {
          "description": "Two character production line identifier.",
          "type": "string",
          "maxLength": 2,
          "minLength": 2
        },
        "raw_batch_node": {
          "description": "OPC-UA node identifier of the raw material batch variable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "raw_part_ref_node": {
          "description": "OPC-UA node identifier of the raw part reference variable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "raw_part_ref_node",
        "raw_batch_node",
        "line_id"
      ]
    },
    "DatabaseClientConfig": {
      "description": "ClickHouse database client configuration.",
      "type": "object",
      "properties": {
        "default_database": {
          "description": "Default database to use.",
          "type": "string"
        },
        "password_file": {
          "description": "Path to a file containing the ClickHouse user's password. Whitespaces around\nthe password will be removed.",
          "type": "string"
        },
        "url": {
          "description": "URL of the ClickHouse HTTP(S) endpoint.",
          "type": "string",
          "format": "uri"
        },
        "user": {
          "description": "ClickHouse user.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "user",
        "password_file",
        "default_database"
      ]
    },
    "MachineConfig": {
      "description": "Connected machine configuration.",
      "type": "object",
      "properties": {
        "opc_ua_server": {
          "description": "OPC-UA server configuration for this machine.",
          "$ref": "#/$defs/OpcUaServerConfig"
        },
        "traceability": {
          "description": "Traceability settings for this machine.",
          "$ref": "#/$defs/MachineTraceabilityConfig"
        }
      },
      "required": [
        "opc_ua_server",
        "traceability"
      ]
    },
    "MachineTraceabilityConfig": {
      "description": "Traceability related configuration for a machine.",
      "type": "object",
      "properties": {
        "namespace_url": {
          "description": "OPC-UA namespace URL used for traceability.",
          "type": "string",
          "format": "uri"
        },
        "nodes": {
          "description": "Traceability-related OPC-UA nodes.",
          "$ref": "#/$defs/TraceabilityOpcUaNodesConfig"
        },
        "part_identifier": {
          "description": "Configuration for part identifier creation, if applicable.",
          "anyOf": [
            {
              "$ref": "#/$defs/CreatePartIdConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "publish_interval": {
          "description": "Publish interval for OPC-UA subscription to request variable.",
          "type": "string"
        }
      },
      "required": [
        "namespace_url",
        "publish_interval",
        "nodes"
      ]
    },
    "MessageSecurityMode": {
      "description": "A copy of [`opcua::crypto::MessageSecurityMode`] to allow using serde remote functionality.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "None",
            "Sign",
            "SignAndEncrypt"
          ]
        }
      ]
    },
    "OpcUaServerConfig": {
      "description": "Connected OPC-UA server configuration.",
      "type": "object",
      "properties": {
        "password": {
          "description": "Password to use if using username/password authentication.",
          "type": [
            "string",
            "null"
          ]
        },
        "security_mode": {
          "description": "OPC-UA security mode.",
          "$ref": "#/$defs/MessageSecurityMode"
        },
        "security_policy": {
          "description": "OPC_UA security policy.",
          "$ref": "#/$defs/SecurityPolicy"
        },
        "url": {
          "description": "OPC-UA server URL.",
          "type": "string",
          "format": "uri"
        },
        "user": {
          "description": "Username if authenticating to the OPC-UA server with username/password.\nIf not provided, anonymous authentication will be used.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "url",
        "security_policy",
        "security_mode"
      ]
    },
    "SecurityPolicy": {
      "description": "A copy of [`opcua::crypto::SecurityPolicy`] to allow using serde remote functionality.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "None",
            "Aes128Sha256RsaOaep",
            "Basic256Sha256",
            "Aes256Sha256RsaPss",
            "Basic128Rsa15",
            "Basic256"
          ]
        }
      ]
    },
    "TraceabilityOpcUaNodesConfig": {
      "description": "OPC-UA nodes used for traceability.",
      "type": "object",
      "properties": {
        "general_part_sheet": {
          "description": "OPC-UA node identifier of the general part sheet object.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "heartbeat": {
          "description": "OPC-UA node identifier of the heartbeat variable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "part_id": {
          "description": "OPC-UA node identifier of the `part ID` variable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "request": {
          "description": "OPC-UA node identifier of the request variable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "response": {
          "description": "OPC-UA node identifier of the response variable.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "request",
        "response",
        "heartbeat",
        "general_part_sheet",
        "part_id"
      ]
    }
  }
}

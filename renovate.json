{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**",
    ".mise/locks/**"
  ],
  "automergeType": "branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * *"],
    "automerge": true
  },
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "description": "Update versions annotated with a renovate comment in mise.toml",
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Track ClickHouse YY.MM release lines from tags like v26.8.3.77-lts",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["ClickHouse/ClickHouse"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+)\\.\\d+\\.\\d+-(?:lts|stable)$"
    },
    {
      "description": "Do not require Minimum Release Age for ClickHouse: the timestamp of a YY.MM line is the one of its latest patch, which is released almost daily",
      "matchDepNames": ["ClickHouse/ClickHouse", "clickhouse/clickhouse-server"],
      "minimumReleaseAge": null
    },
    {
      "description": "Update the ClickHouse version of the integration tests (mise) and of the package tests (Docker image) together",
      "matchDepNames": ["ClickHouse/ClickHouse", "clickhouse/clickhouse-server"],
      "groupName": "ClickHouse"
    },
    {
      "matchDepNames": ["rust"],
      "matchManagers": ["mise"],
      "semanticCommitType": "fix"
    },
    {
      "matchDepTypes": ["dependencies", "workspace.dependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["dev-dependencies"],
      "automerge": true
    },
    {
      "description": "Do not require Minimum Release Age for update types that are controlled by the package manager",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "Disable update PRs (in favor of lock file maintenance) for mise tools with requested version being latest or lts",
      "matchDepTypes": ["tools"],
      "matchCurrentValue": "@(latest|lts)",
      "enabled": false
    }
  ]
}

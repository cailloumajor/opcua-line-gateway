{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**",
    ".mise/locks/**"
  ],
  "automergeType": "branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * *"],
    "automerge": true
  },
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Update the ClickHouse version of the integration tests (mise) and of the package tests (Docker image) together",
      "matchManagers": ["mise", "docker-compose"],
      "matchDepNames": ["clickhouse", "clickhouse/clickhouse-server"],
      "groupName": "ClickHouse"
    },
    {
      "description": "Update the clickhouse crate together with its HTTP stack crates, whose versions must match the ones it uses for the custom HTTP client to implement its HttpClient trait",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["clickhouse", "hyper-rustls", "hyper-util", "rustls"],
      "groupName": "clickhouse crate HTTP stack"
    },
    {
      "matchDepNames": ["rust"],
      "matchManagers": ["mise"],
      "semanticCommitType": "fix"
    },
    {
      "matchDepTypes": ["dependencies", "workspace.dependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchDepTypes": ["dev-dependencies"],
      "automerge": true
    },
    {
      "description": "Do not require Minimum Release Age for update types that are controlled by the package manager",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "Disable update PRs (in favor of lock file maintenance) for mise tools with requested version being latest or lts",
      "matchDepTypes": ["tools"],
      "matchCurrentValue": "@(latest|lts)",
      "enabled": false
    }
  ]
}

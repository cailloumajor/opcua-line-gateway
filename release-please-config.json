{
  "$schema": "https://github.com/googleapis/release-please/raw/refs/heads/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {}
  },
  "extra-files": [
    {
      "type": "toml",
      "path": "Cargo.toml",
      "jsonpath": "$.workspace.package.version"
    },
    {
      "type": "toml",
      "path": "Cargo.lock",
      "jsonpath": "$.package[?(!@.source)].version"
    }
  ]
}

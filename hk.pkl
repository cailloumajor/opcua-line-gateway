amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["actionlint"] = Builtins.actionlint
  ["betterleaks"] = Builtins.betterleaks
  ["cargo-clippy"] = Builtins.cargo_clippy
  ["cargo-fmt"] = Builtins.cargo_fmt
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["ghalint"] = Builtins.ghalint_workflow
  ["config-schema"] {
    check_diff = "mise run config-schema --diff"
    fix = "mise run config-schema"
    stage = "schema/config.schema.json"
  }
  ["config-doc"] {
    check_diff = "mise run config-doc --diff"
    fix = "mise run config-doc"
    stage = "docs/configuration.md"
  }
  ["pinact"] = Builtins.pinact
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["rumdl"] = Builtins.rumdl
  ["tombi"] = Builtins.tombi
  ["typos"] = Builtins.typos
  ["zizmor"] = Builtins.zizmor
}

env {
  ["CARGO_BUILD_WARNINGS"] = "deny"
}

exclude = "CHANGELOG.md"

hooks {
  ["commit-msg"] {
    steps {
      ["check-conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
